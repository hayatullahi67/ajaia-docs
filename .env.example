# Neon Postgres. In the Neon dashboard, "Connect" shows both strings:
# pooled (host contains "-pooler") for the app, direct (no "-pooler") for migrations.
# connect_timeout gives Neon's free tier time to wake from sleep.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&pool_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Any long random string. Generate one with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"
